{% set footer_about = theme.settings.get('footer_about', '') %}
<footer data-testid="store-footer" class="store-footer n-footer">

  {# اللوجو في المنتصف #}
  <div class="n-footer__brand">
    <div class="container">
      <a href="{{ link('/') }}" class="n-footer__logo" aria-label="{{ store.name }}">
        {% if theme.settings.get('footer_show_logo', true) and store.logo %}
          <img loading="lazy" src="{{ store.logo|cdn(350) }}" alt="{{ store.name }}">
        {% else %}
          <span class="n-footer__name">{{ store.name }}</span>
        {% endif %}
      </a>
      {% if footer_about %}
        <p class="n-footer__about">{{ footer_about }}</p>
      {% elseif store.description %}
        <div class="n-footer__about">{{ store.description|raw }}</div>
      {% endif %}
      <salla-social data-testid="store-footer-social" class="n-footer__social"></salla-social>
    </div>
  </div>

  {# الأعمدة #}
  <div aria-label="footer" class="store-footer__inner n-footer__cols">
    <div class="container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <div>
        <h3>{{ trans('blocks.footer.pages_links') }}</h3>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      <div>
        <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
      </div>

      <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>

      <div class="n-footer__trust">
        <salla-trust-badges data-testid="store-footer-trust-badges" {% if theme.settings.get('footer_is_dark', true) %} dark {% endif %}></salla-trust-badges>
        {% if store.settings.tax.number %}
          <div class="flex rtl:space-x-reverse space-x-2 items-end">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                <img width="40" height="50" src="{{ 'images/tax.png' | cdn(70,70) }}" loading="lazy" class="w-10 rounded-sm hover:opacity-80 transition-opacity" alt="value added tax">
              </a>
            {% endif %}
            <div>
              <p class="text-sm opacity-70 mb-1">{{ trans('common.elements.tax_number') }}</p>
              <b class="text-sm">{{ store.settings.tax.number }}</b>
            </div>
          </div>
          {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  {# الحقوق ووسائل الدفع #}
  <div class="n-footer__bottom">
    <div class="container">
      <salla-payments data-testid="store-footer-payments"></salla-payments>
      <span class="copyright-text">{% hook copyright %}</span>
    </div>
  </div>
</footer>
