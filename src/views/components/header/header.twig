{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set ticker_on = theme.settings.get('ticker_enabled', true) %}
{% set ticker_text = theme.settings.get('ticker_text', '') %}
{% set tagline = theme.settings.get('header_tagline', '') %}
<header data-testid="store-header" class="store-header n-header">

  {# شريط العروض المتحرك #}
  {% if ticker_on and ticker_text %}
    {% set ticker_lines = ticker_text|replace({"\r": ''})|split("\n") %}
    <div class="n-ticker" role="region" aria-label="{{ theme.is_rtl ? 'عروض المتجر' : 'Store offers' }}">
      <div class="n-ticker__track">
        {% for i in 1..4 %}
          {% for line in ticker_lines %}
            {% if line|trim %}
              <span class="n-ticker__item" {{ i > 1 ? 'aria-hidden=true' : '' }}>{{ line|trim }}</span>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container n-mainnav">
    <div class="inner bg-white w-full">
      <div class="container">
        <div class="n-header__row">

          {# البداية: القائمة والبحث واللغة #}
          <div class="n-header__start">
            <a data-testid="store-header-mobile-toggle" class="lg:hidden n-icon-btn" href="#mobile-menu" aria-label="Open-menu">
              <i class="sicon-menu"></i>
            </a>
            <button type="button" class="lg:hidden n-icon-btn" aria-label="{{ trans('common.elements.search') }}" onclick="salla.event.dispatch('search::open')">
              <i class="sicon-search"></i>
            </button>
            <div class="hidden lg:block n-header__search">
              <salla-search data-testid="store-header-search" inline oval height="44"></salla-search>
            </div>
            <div class="hidden lg:flex items-center gap-2">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
              {% if store.scope %}
                <button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
                </button>
              {% endif %}
              <salla-bullet-delivery-tag class="hidden lg:block"></salla-bullet-delivery-tag>
            </div>
          </div>

          {# المنتصف: اللوجو #}
          <a data-testid="store-header-logo" class="navbar-brand n-logo" href="{{ store.url }}">
            <img fetchpriority="high" loading="eager" src="{{ store.logo|cdn(350) }}" alt="{{ store.name }} logo">
            {% if tagline %}
              <span class="n-logo__tagline">{{ tagline }}</span>
            {% endif %}
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          {# النهاية: الحساب والسلة #}
          <div class="n-header__end">
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
            <salla-cart-summary data-testid="store-header-cart">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
            </salla-cart-summary>
          </div>
        </div>
      </div>

      {# القائمة الرئيسية تحت اللوجو #}
      <div class="n-header__menu">
        <div class="container">
          <custom-main-menu></custom-main-menu>
        </div>
      </div>
    </div>
  </div>
</header>
