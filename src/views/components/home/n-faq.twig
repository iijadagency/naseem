{#
| Variable                   | Type     | Description       |
|----------------------------|----------|-------------------|
| component.title            | ?string  | عنوان القسم       |
| component.items            | object[] | الأسئلة           |
| component.items[].question | string   | السؤال            |
| component.items[].answer   | string   | الإجابة           |
#}
{% set t = component.title is iterable ? component.title[language.code]|default(component.title|first) : component.title %}
{% if component.items|length %}
<section component-id="{{ componentId }}" class="s-block n-faq-block">
  <div class="container">
    {% if t %}
      <div class="s-block__title justify-center text-center">
        <div class="right-side"><h2>{{ t }}</h2></div>
      </div>
    {% endif %}
    <div class="n-faq">
      {% for item in component.items %}
        {% set q = item.question is iterable ? item.question[language.code]|default(item.question|first) : item.question %}
        {% set a = item.answer is iterable ? item.answer[language.code]|default(item.answer|first) : item.answer %}
        {% if q %}
          <details {{ loop.first ? 'open' : '' }}>
            <summary>{{ q }}</summary>
            <div class="n-faq__answer">{{ a|nl2br }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
