{#
| Variable              | Type       | Description                          |
|-----------------------|------------|--------------------------------------|
| component.title       | ?string    | عنوان القسم                          |
| component.categories  | Category[] | التصنيفات المختارة                   |
| component.slow        | ?bool      | حركة أبطأ                            |
| component.square      | ?bool      | صور مربعة بدل الدائرية               |
#}
{% set t = component.title is iterable ? component.title[language.code]|default(component.title|first) : component.title %}
{% set cats = component.categories %}
{% set reps = cats|length < 6 ? 4 : 2 %}
{% if cats|length %}
<section component-id="{{ componentId }}" class="s-block n-cats {{ component.square ? 'n-cats--square' : '' }}">
  {% if t %}
    <div class="container">
      <div class="s-block__title">
        <div class="right-side"><h2>{{ t }}</h2></div>
      </div>
    </div>
  {% endif %}
  <div class="n-marquee" style="--n-speed: {{ component.slow ? 70 : 45 }}s">
    <div class="n-marquee__track">
      {% for i in 1..reps %}
        {% for cat in cats %}
          <div class="n-marquee__item" {{ i > 1 ? 'aria-hidden=true' : '' }}>
            <a href="{{ cat.url }}" class="n-cat" {{ i > 1 ? 'tabindex=-1' : '' }}>
              <span class="n-cat__img">
                <img src="{{ cat.image ?: 'images/placeholder.png'|asset }}" alt="" loading="lazy" width="172" height="172">
              </span>
              <span class="n-cat__name">{{ cat.name }}</span>
            </a>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
