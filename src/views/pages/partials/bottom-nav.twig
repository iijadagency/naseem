{# شريط التنقل السفلي للجوال — يظهر على الشاشات الصغيرة فقط #}
<nav class="n-bottom-nav lg:hidden" aria-label="{{ trans('blocks.header.main_menu') }}">
  <a href="{{ link('/') }}" class="n-bottom-nav__item {{ is_page('index') ? 'is-active' : '' }}">
    <i class="sicon-home" aria-hidden="true"></i>
    <span>{{ theme.is_rtl ? 'الرئيسية' : 'Home' }}</span>
  </a>
  <a href="#mobile-menu" class="n-bottom-nav__item">
    <i class="sicon-list" aria-hidden="true"></i>
    <span>{{ theme.is_rtl ? 'الأقسام' : 'Categories' }}</span>
  </a>
  <button type="button" class="n-bottom-nav__item" onclick="salla.event.dispatch('search::open')">
    <i class="sicon-search" aria-hidden="true"></i>
    <span>{{ theme.is_rtl ? 'بحث' : 'Search' }}</span>
  </button>
  <a href="{{ link('wishlist') }}" class="n-bottom-nav__item {{ is_page('customer.wishlist') ? 'is-active' : '' }}">
    <i class="sicon-heart" aria-hidden="true"></i>
    <span>{{ theme.is_rtl ? 'المفضلة' : 'Wishlist' }}</span>
  </a>
  {% if user.type == 'user' %}
    <a href="{{ link('profile') }}" class="n-bottom-nav__item {{ is_page('customer.profile') ? 'is-active' : '' }}">
      <i class="sicon-user" aria-hidden="true"></i>
      <span>{{ theme.is_rtl ? 'حسابي' : 'Account' }}</span>
    </a>
  {% else %}
    <button type="button" class="n-bottom-nav__item" onclick="salla.event.dispatch('login::open')">
      <i class="sicon-user" aria-hidden="true"></i>
      <span>{{ theme.is_rtl ? 'دخول' : 'Login' }}</span>
    </button>
  {% endif %}
</nav>
